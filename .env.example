# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is in .gitignore / not shared - it holds your secret bot token.

# Required. Get this from the Discord Developer Portal - see README.md step 3.
DISCORD_TOKEN=

# Optional. The server's default IANA timezone: used to understand "at 9pm"
# from anyone who hasn't set their own with /timezone, and for where each
# calendar month starts. Times the bot posts are shown in each viewer's own
# timezone regardless. Default below is Pacific Time. Full list of valid names:
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BOT_TIMEZONE=America/Los_Angeles

# Optional. +/- this many minutes still counts as "on time". Default: 2
GRACE_PERIOD_MINUTES=2

# Optional. A stated plan is marked a no-show if the person never joins voice
# within this many hours after their stated time. Default: 12
PLAN_EXPIRY_HOURS=12

# Optional. Minutes late (or more) before the join reply swaps in a random
# passive-aggressive line instead of the plain "late by N min" text. Edit or
# add your own lines in src/roastLines.js. Default: 30
ROAST_THRESHOLD_MINUTES=30

# Optional. The mirror image of the above: minutes EARLY (or more) before the
# join reply calls you out for not sticking to the time you yourself gave.
# Uses its own separate pool of lines in src/roastLines.js. Default: 60
EARLY_SCOLD_THRESHOLD_MINUTES=60

# Optional. How far ahead a stated time can be before the bot decides it isn't
# a "joining soon" plan at all and ignores it. This is the parsing limit, not
# the no-show limit. Raise it if your group announces plans further out than
# this. Default: 12
MAX_FUTURE_HOURS=12

# Optional. Comma-separated text channel IDs to restrict the bot to (right-click
# a channel in Discord with Developer Mode on -> Copy Channel ID). Leave blank
# to scan every channel the bot can see.
ALLOWED_CHANNEL_IDS=

# Optional. Where the leaderboard history (a JSON file) is stored. Only
# needed if you're pointing it at a persistent volume on a host - see
# README Part 4, Option B.
DB_PATH=

# Optional. Where the bot remembers which channel+message is the live
# leaderboard set up with /leaderboard-here. Same deal as DB_PATH above -
# only needed if pairing it with a persistent volume.
LIVE_LEADERBOARD_PATH=

# Optional. Where the bot remembers which channel is the voice-join log set
# up with /log-here. Same deal as DB_PATH above - only needed if pairing it
# with a persistent volume.
LOG_CHANNEL_PATH=

# Optional. Where the bot remembers which channel gets the automatic monthly
# awards post set up with /awards-here, and which month was last announced.
# Same deal as DB_PATH above - only needed if pairing it with a persistent
# volume.
AWARDS_CHANNEL_PATH=

# Optional. Where the bot remembers each person's own timezone, set with
# /timezone. Same deal as DB_PATH above.
USER_TIMEZONE_PATH=

# Optional. Set automatically by most hosting platforms - you usually don't
# need to set this yourself. See README "Hosting" section.
PORT=
